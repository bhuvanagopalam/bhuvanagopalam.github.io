---
import ContactSection from "../components/ContactSection.astro";
import ExperienceSection from "../components/ExperienceSection.astro";
import Hero from "../components/Hero.astro";
import ProjectsSection from "../components/ProjectsSection.astro";
import ResearchOutputsSection from "../components/ResearchOutputsSection.astro";
import SkillsSection from "../components/SkillsSection.astro";
import StatsBar from "../components/StatsBar.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
---

<BaseLayout
  title={profile.name}
  seoTitle={`${profile.name} | Applied AI and Machine Learning`}
  description={profile.summary}
>
  <Hero />

  <StatsBar />

  <SkillsSection />

  <ExperienceSection />

  <ProjectsSection />

  <ResearchOutputsSection />

  <ContactSection />
</BaseLayout>
