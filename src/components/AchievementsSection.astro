---
import { achievements } from "../data/achievements";
---

{achievements.length > 0 && (
<section class="section compact-section" id="achievements" aria-labelledby="achievements-title">
  <div class="container">
    <div class="compact-heading">
      <h2 id="achievements-title">Achievements</h2>
      <span aria-hidden="true"></span>
    </div>

    <div class="achievement-grid">
      {
        achievements.map((item) => {
          const [cover, ...more] = item.photos ?? [];

          return (
            <article class:list={["achievement-card", cover && "achievement-card--photo"]}>
              {cover && (
                <figure class="achievement-card__media">
                  <img src={cover.src} alt={cover.alt} loading="lazy" decoding="async" style={cover.focus ? `object-position: ${cover.focus}` : undefined} />
                  {cover.caption && <figcaption>{cover.caption}</figcaption>}
                </figure>
              )}

              <div class="achievement-card__body">
                <div class="achievement-card__top">
                  <span class="achievement-card__kind">{item.kind}</span>
                  <span class="achievement-card__date">{item.date}</span>
                </div>
                <h3>{item.title}</h3>
                <p class="achievement-card__issuer">{item.issuer}</p>
                <p class="achievement-card__summary">{item.summary}</p>

                {item.details?.length ? (
                  <ul class="card-details">
                    {item.details.map((line) => <li>{line}</li>)}
                  </ul>
                ) : null}

                {more.length > 0 && (
                  <ul class="photo-strip" aria-label={`More photos for ${item.title}`}>
                    {more.map((photo) => (
                      <li>
                        <a href={photo.src} target="_blank" rel="noreferrer" title={photo.caption ?? photo.alt}>
                          <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}

                {item.links?.length ? (
                  <ul class="compact-links" aria-label={`${item.title} links`}>
                    {item.links.map((link) => (
                      <li>
                        <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
)}
