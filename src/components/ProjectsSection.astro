---
import { projects } from "../data/projects";
---

<section class="section compact-section" id="projects" aria-labelledby="projects-title">
  <div class="container">
    <div class="compact-heading">
      <h2 id="projects-title">Projects</h2>
      <span aria-hidden="true"></span>
    </div>

    <div class="project-grid">
      {
        projects.map((project) => (
          <article class="project-card">
            <div class="project-card__content">
              <h3>
                {
                  project.slug ? (
                    <a class="project-card__title-link" href={`/projects/${project.slug}/`}>
                      {project.title}
                      <span class="project-card__title-arrow" aria-hidden="true">
                        <svg viewBox="0 0 24 24" focusable="false">
                          <line x1="5" y1="12" x2="19" y2="12" />
                          <polyline points="12 5 19 12 12 19" />
                        </svg>
                      </span>
                    </a>
                  ) : (
                    project.title
                  )
                }
              </h3>
              <p>{project.summary}</p>
              {project.slug && (
                <a class="project-card__walkthrough" href={`/projects/${project.slug}/`}>
                  Read the walkthrough
                </a>
              )}
            </div>

            <div class="project-card__stack">
              <span>Stack</span>
              <ul aria-label={`${project.title} stack`}>
                {project.tags.map((tag) => <li>{tag}</li>)}
              </ul>
            </div>

            <div class="project-card__footer">
              {
                project.links?.length ? (
                  <ul class="project-card__links" aria-label={`${project.title} links`}>
                    {project.links.map((link) => (
                      <li>
                        <a href={link.href} target="_blank" rel="noreferrer">
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <span class="project-card__link-muted">Link pending</span>
                )
              }
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
