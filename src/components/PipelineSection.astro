---
// Walkthrough of the SQVQA architecture. The copy describes what each stage
// does rather than quoting model output, so nothing here claims to be a live
// inference result.
const stages = [
  {
    label: "Input",
    model: "Image",
    body: "An image goes in on its own - no labels, no metadata, no hand-written prompt describing what to look for.",
  },
  {
    label: "Observe",
    model: "Qwen2-VL",
    body: "A vision-language model reads the image and writes a plain-language observation: leaf shape and serration, branching pattern, trichomes, flowering structures.",
  },
  {
    label: "Self-question",
    model: "The twist",
    body: "Rather than answering straight away, that written observation becomes the question put to the next model. The system interrogates what it just saw.",
  },
  {
    label: "Answer",
    model: "OFA VQA",
    body: "A fine-tuned OFA model answers that question against the original image, returning a decision alongside the reasoning points behind it.",
  },
];
---

<section class="section pipeline-section" id="pipeline" aria-labelledby="pipeline-title">
  <div class="container">
    <div class="compact-heading">
      <h2 id="pipeline-title">Inside SQVQA</h2>
      <span aria-hidden="true"></span>
    </div>

    <p class="pipeline-intro">
      Most visual question answering systems are handed a question. This one writes its own -
      it describes what it sees, then answers the description it just produced.
    </p>

    <div class="pipeline" data-pipeline>
      <figure class="pipeline-input">
        <img
          src="/images/sqvqa-example.jpg"
          alt="Field photograph of dense vegetation, the kind of image the screening pipeline is given"
          loading="lazy"
          width="720"
          height="540"
        />
        <figcaption>A sample input from the screening set</figcaption>
      </figure>

      <ol class="pipeline-stages">
        {
          stages.map((stage, index) => (
            <li class="pipeline-stage" data-stage={index}>
              <div class="pipeline-stage__marker" aria-hidden="true">
                <span>{index + 1}</span>
              </div>
              <div class="pipeline-stage__content">
                <div class="pipeline-stage__head">
                  <h3>{stage.label}</h3>
                  <span class="pipeline-stage__model">{stage.model}</span>
                </div>
                <p>{stage.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="pipeline-footer">
      <p class="pipeline-result">
        <strong>90% accuracy</strong> with zero false positives on the evaluation set
      </p>
      <button class="pipeline-replay" type="button" data-pipeline-replay hidden>
        Replay
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M3 12a9 9 0 1 0 3-6.7" />
          <polyline points="3 4 3 10 9 10" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const pipeline = document.querySelector("[data-pipeline]");
    if (!pipeline) return;

    const stages = [...pipeline.querySelectorAll(".pipeline-stage")];
    const replay = document.querySelector("[data-pipeline-replay]");
    if (!stages.length) return;

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Without motion (or without IntersectionObserver) every stage is simply
    // shown, so the content is never gated behind an animation that may not run.
    if (reduceMotion || typeof IntersectionObserver === "undefined") {
      stages.forEach((s) => s.classList.add("is-active"));
      return;
    }

    let timers = [];

    const clearTimers = () => {
      timers.forEach(clearTimeout);
      timers = [];
    };

    const play = () => {
      clearTimers();
      stages.forEach((s) => s.classList.remove("is-active"));
      stages.forEach((stage, index) => {
        timers.push(setTimeout(() => stage.classList.add("is-active"), 260 + index * 620));
      });
      // Guarantee every stage ends up visible even if a timer is throttled.
      timers.push(
        setTimeout(
          () => stages.forEach((s) => s.classList.add("is-active")),
          260 + stages.length * 620 + 900,
        ),
      );
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          play();
          if (replay) replay.hidden = false;
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.3 },
    );

    observer.observe(pipeline);
    if (replay) replay.addEventListener("click", play);
  })();
</script>
