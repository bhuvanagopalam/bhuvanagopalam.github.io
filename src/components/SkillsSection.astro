---
import SkillIcon from "./SkillIcon.astro";
import { skillGroups } from "../data/skills";

type Tone = "blue" | "gold" | "green" | "rose" | "teal";

const tones: Tone[] = ["teal", "blue", "gold", "green", "rose"];

const groupMeta: Record<string, { tone: Tone }> = {
  "Programming Languages": {
    tone: "teal",
  },
  "Machine Learning & AI": {
    tone: "blue",
  },
  "ML Frameworks": {
    tone: "gold",
  },
  "LLMs & Applied AI": {
    tone: "green",
  },
  "Data Science Libraries": {
    tone: "rose",
  },
  "Computer Vision Tools": {
    tone: "teal",
  },
  "Backend, Data & Infrastructure": {
    tone: "blue",
  },
  "Tools & Analytics": {
    tone: "gold",
  },
};
---

<section class="section skills-section" id="skills" aria-labelledby="skills-title">
  <div class="container">
    <div class="skills-heading">
      <h2 id="skills-title">Skills</h2>
      <span aria-hidden="true"></span>
    </div>

    <div class="skills-pattern" aria-label="Grouped technical skills">
      {
        skillGroups.map((group, index) => {
          const meta = groupMeta[group.title] ?? { tone: tones[index % tones.length] };

          return (
            <article
              class:list={[
                "skill-row",
                `skill-row--${meta.tone}`,
              ]}
            >
              <div class="skill-row__title">
                <h3>{group.title}</h3>
              </div>

              <ul class="skill-chip-list">
                {
                  group.skills.map((skill) => (
                    <li class="skill-chip">
                      <SkillIcon icon={skill.icon} />
                      <span>{skill.name}</span>
                    </li>
                  ))
                }
              </ul>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
