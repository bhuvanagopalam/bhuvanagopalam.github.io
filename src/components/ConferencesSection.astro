---
import { conferences } from "../data/conferences";
---

{conferences.length > 0 && (
<section class="section compact-section" id="conferences" aria-labelledby="conferences-title">
  <div class="container">
    <div class="compact-heading">
      <h2 id="conferences-title">Conferences</h2>
      <span aria-hidden="true"></span>
    </div>

    <div class:list={["presentation-grid", conferences.length === 1 && "presentation-grid--single"]}>
      {
        conferences.map((item) => {
          const [cover, ...more] = item.photos ?? [];
          const meta = [item.role, item.organizer, item.location].filter(Boolean).join(" · ");

          return (
            <article class:list={["presentation-card", conferences.length === 1 && cover && "presentation-card--wide"]}>
              {cover && (
                <figure class="presentation-card__media">
                  <img src={cover.src} alt={cover.alt} loading="lazy" decoding="async" style={cover.focus ? `object-position: ${cover.focus}` : undefined} />
                  {cover.caption && <figcaption>{cover.caption}</figcaption>}
                </figure>
              )}

              <div class="presentation-card__body">
                <span class="presentation-card__date">{item.date}</span>
                <h3>{item.name}</h3>
                <p class="presentation-card__meta">{meta}</p>
                <p class="presentation-card__summary">{item.summary}</p>

                {item.details?.length ? (
                  <ul class="card-details">
                    {item.details.map((line) => <li>{line}</li>)}
                  </ul>
                ) : null}

                {more.length > 0 && (
                  <ul class="photo-strip" aria-label={`More photos from ${item.name}`}>
                    {more.map((photo) => (
                      <li>
                        <a href={photo.src} target="_blank" rel="noreferrer" title={photo.caption ?? photo.alt}>
                          <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}

                {item.links?.length ? (
                  <ul class="compact-links" aria-label={`${item.name} links`}>
                    {item.links.map((link) => (
                      <li>
                        <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
)}
