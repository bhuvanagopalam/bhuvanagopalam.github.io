---
import BrandIcon from "./BrandIcon.astro";
import { contactForm, profile } from "../data/profile";

const emailAddress = profile.links.email.replace("mailto:", "");
const accessKey = contactForm.web3formsAccessKey;

const contactLinks = [
  {
    label: "Email",
    value: emailAddress,
    href: profile.links.email,
    icon: "email",
    tone: "email",
  },
  {
    label: "GitHub",
    value: profile.links.github.replace("https://", ""),
    href: profile.links.github,
    icon: "github",
    tone: "github",
  },
  {
    label: "LinkedIn",
    value: "in/bhuvana-gopalam",
    href: profile.links.linkedin,
    icon: "linkedin",
    tone: "linkedin",
  },
].filter((item) => item.href);
---

<section class="section contact-section" id="contact" aria-labelledby="contact-title">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-intro">
        <p class="section__kicker">Get in Touch</p>
        <h2 class="section__title" id="contact-title">Let's build something together</h2>
        <p class="section__intro contact-intro__lead">
          Open to machine learning and applied AI roles, research collaborations, and
          interesting project conversations. If you are working on something in computer
          vision, vision-language models, or applied ML, I would love to connect.
        </p>

        <div class="contact-links">
          {
            contactLinks.map((item) => (
              <a
                class:list={["contact-link", `contact-link--${item.tone}`]}
                href={item.href}
                target={item.href.startsWith("mailto:") ? undefined : "_blank"}
                rel={item.href.startsWith("mailto:") ? undefined : "noreferrer"}
              >
                <span class="contact-link__icon" aria-hidden="true">
                  <BrandIcon name={item.icon} />
                </span>
                <span class="contact-link__text">
                  <strong>{item.label}</strong>
                  <small>{item.value}</small>
                </span>
                <span class="contact-link__arrow" aria-hidden="true">
                  <svg viewBox="0 0 24 24" focusable="false">
                    <line x1="7" y1="17" x2="17" y2="7" />
                    <polyline points="7 7 17 7 17 17" />
                  </svg>
                </span>
              </a>
            ))
          }
        </div>

        <div class="contact-availability">
          <h3>Currently available for</h3>
          <p>{profile.availability}</p>
        </div>
      </div>

      <div class="contact-form-card">
        <h3 class="contact-form-card__title">Send a message</h3>
        <p class="contact-form-card__note">
          {
            accessKey
              ? "Sent straight to my inbox — I usually reply within a day or two."
              : "This opens your email app with everything filled in, so you can review before hitting send."
          }
        </p>

        <form class="contact-form" data-contact-form>
          <div class="contact-form__row">
            <div class="contact-form__group">
              <label for="contact-name">Name</label>
              <input id="contact-name" name="name" type="text" placeholder="Jane Doe" required />
            </div>
            <div class="contact-form__group">
              <label for="contact-email">Email</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                placeholder="jane@company.com"
                required
              />
            </div>
          </div>

          <div class="contact-form__group">
            <label for="contact-subject">Subject</label>
            <input
              id="contact-subject"
              name="subject"
              type="text"
              placeholder="Collaboration, role, or research"
            />
          </div>

          <div class="contact-form__group">
            <label for="contact-message">Message</label>
            <textarea
              id="contact-message"
              name="message"
              rows="5"
              placeholder="Tell me about the opportunity or what you'd like to discuss..."
              required></textarea>
          </div>

          {/* Honeypot: bots fill hidden fields, humans never see this one. */}
          <input
            class="contact-form__honeypot"
            type="checkbox"
            name="botcheck"
            tabindex="-1"
            autocomplete="off"
          />

          <button class="contact-form__submit" type="submit" data-form-submit>
            Send Message
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <line x1="22" y1="2" x2="11" y2="13" />
              <polygon points="22 2 15 22 11 13 2 9 22 2" />
            </svg>
          </button>

          <p class="contact-form__status" data-form-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ recipient: emailAddress, accessKey }}>
  (() => {
    const form = document.querySelector("[data-contact-form]");
    if (!(form instanceof HTMLFormElement)) return;

    const button = form.querySelector("[data-form-submit]");
    const status = form.querySelector("[data-form-status]");

    const readFields = () => {
      const data = new FormData(form);
      return {
        name: String(data.get("name") || "").trim(),
        email: String(data.get("email") || "").trim(),
        subject: String(data.get("subject") || "").trim(),
        message: String(data.get("message") || "").trim(),
        botcheck: data.get("botcheck"),
      };
    };

    const setStatus = (text, tone) => {
      if (!status) return;
      status.textContent = text;
      status.dataset.tone = tone || "";
    };

    // Without an access key configured there is no backend to post to, so hand
    // off to the visitor's mail client rather than pretending the send worked.
    const openMailClient = ({ name, email, subject, message }) => {
      const finalSubject = subject || `Portfolio enquiry from ${name}`;
      const body = `${message}\n\n---\nFrom: ${name}\nReply to: ${email}`;
      window.location.href = `mailto:${recipient}?subject=${encodeURIComponent(
        finalSubject,
      )}&body=${encodeURIComponent(body)}`;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const fields = readFields();

      if (!accessKey) {
        openMailClient(fields);
        return;
      }

      // Silently accept-and-drop anything that trips the honeypot.
      if (fields.botcheck) {
        setStatus("Thanks - your message has been sent.", "success");
        form.reset();
        return;
      }

      if (button) button.disabled = true;
      setStatus("Sending...", "pending");

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify({
            access_key: accessKey,
            subject: fields.subject || `Portfolio enquiry from ${fields.name}`,
            from_name: "Portfolio contact form",
            name: fields.name,
            email: fields.email,
            message: fields.message,
          }),
        });

        const result = await response.json().catch(() => ({}));

        // Only report success when the API actually confirms it.
        if (response.ok && result.success) {
          setStatus("Thanks - your message has been sent. I'll reply soon.", "success");
          form.reset();
        } else {
          setStatus(
            `Something went wrong, so the message was not sent. Please email me directly at ${recipient}.`,
            "error",
          );
        }
      } catch {
        setStatus(
          `Could not reach the server, so the message was not sent. Please email me directly at ${recipient}.`,
          "error",
        );
      } finally {
        if (button) button.disabled = false;
      }
    });
  })();
</script>
