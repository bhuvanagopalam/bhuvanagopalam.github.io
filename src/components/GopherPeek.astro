---
// An original gopher illustration in maroon and gold - a nod to Minnesota's
// mascot, not a copy of it, since Goldy's artwork is trademarked. Decorative
// only, so it is hidden from assistive tech.
//
// Reading as a gopher rather than a bear comes down to: a wide flat head, small
// ears set low at the sides, a long snout, and oversized incisors.
---

<div class="gopher" aria-hidden="true">
  <svg viewBox="0 0 140 120" role="presentation" focusable="false">
    <!-- ears: small, low, tucked to the sides -->
    <ellipse cx="30" cy="46" rx="10" ry="11" fill="#a06f42" />
    <ellipse cx="30" cy="46" rx="5" ry="6" fill="#d19a6d" />
    <ellipse cx="110" cy="46" rx="10" ry="11" fill="#a06f42" />
    <ellipse cx="110" cy="46" rx="5" ry="6" fill="#d19a6d" />

    <!-- head: wide and flat-topped, not a circle -->
    <path
      d="M70 16c-27 0-45 14-45 34 0 24 20 40 45 40s45-16 45-40c0-20-18-34-45-34Z"
      fill="#c08a56"
    />

    <!-- brow ridge, keeps the forehead from reading as a dome -->
    <path d="M40 40c8-6 18-9 30-9s22 3 30 9" stroke="#a06f42" stroke-width="3" fill="none" stroke-linecap="round" />

    <!-- eyes -->
    <ellipse cx="53" cy="48" rx="6.5" ry="7.5" fill="#2d2118" />
    <circle cx="55.2" cy="45.2" r="2.2" fill="#fffdf8" />
    <ellipse cx="87" cy="48" rx="6.5" ry="7.5" fill="#2d2118" />
    <circle cx="89.2" cy="45.2" r="2.2" fill="#fffdf8" />

    <!-- long snout with cheek pouches -->
    <ellipse cx="70" cy="70" rx="30" ry="19" fill="#e4c8a6" />
    <ellipse cx="44" cy="70" rx="10" ry="9" fill="#dcbd97" />
    <ellipse cx="96" cy="70" rx="10" ry="9" fill="#dcbd97" />

    <!-- nose and grin -->
    <ellipse cx="70" cy="61" rx="6" ry="4.6" fill="#5c3b28" />
    <path d="M70 66v4M70 70c-5 0-9-2.5-11-5M70 70c5 0 9-2.5 11-5" stroke="#5c3b28" stroke-width="2.4" fill="none" stroke-linecap="round" />

    <!-- the incisors: the part that makes it a gopher -->
    <rect x="62" y="70" width="7.4" height="17" rx="2.4" fill="#fffdf8" stroke="#cbbda6" stroke-width="1.1" />
    <rect x="70.6" y="70" width="7.4" height="17" rx="2.4" fill="#fffdf8" stroke="#cbbda6" stroke-width="1.1" />

    <!-- whiskers -->
    <path d="M40 66l-14-4M40 72l-15 2M100 66l14-4M100 72l15 2" stroke="#a06f42" stroke-width="1.8" stroke-linecap="round" />

    <!-- maroon and gold scarf, tucked behind the card edge -->
    <path d="M26 92c13 8 27 12 44 12s31-4 44-12v14H26Z" fill="#8a2438" />
    <path d="M26 101c13 7 27 10 44 10s31-3 44-10v7H26Z" fill="#c9962e" />

    <!-- paws gripping the edge -->
    <ellipse cx="32" cy="99" rx="11" ry="7.5" fill="#c08a56" />
    <ellipse cx="108" cy="99" rx="11" ry="7.5" fill="#c08a56" />
    <path d="M28 99h8M30 95.5v7M104 99h8M106 95.5v7" stroke="#a06f42" stroke-width="1.5" stroke-linecap="round" />
  </svg>
</div>
